        <mxCell id="4iiBYSx3jzU68GqX29AV-39" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Times New Roman;align=center;fillColor=none;fontColor=#333333;strokeColor=light-dark(#fa0000, #959595);" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left; background-color: rgb(255, 255, 255);&quot;&gt;El botón&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left;&quot;&gt;Acepta Complementaria&lt;/b&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;se habilita si la gestión está en estado&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left;&quot;&gt;PC&lt;/b&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;o&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left;&quot;&gt;PRT&lt;/b&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; font-size: 11px; text-align: left; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;(Pendiente de Aceptar Complementaria o Pendiente de Rectificación)&lt;/span&gt;" vertex="1">
